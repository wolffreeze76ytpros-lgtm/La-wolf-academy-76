# La-wolf-academy-76
Abonnement 
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WOLF ACADEMY 76 | Officiel</title>
    <style>
        :root { --wolf-orange: #ff4500; --wolf-gold: #ffd700; --wolf-red: #ff0000; }
        
        body { 
            font-family: 'Segoe UI', sans-serif; 
            margin: 0; overflow-x: hidden;
            background-image: url('fond_alpha.png'); 
            background-size: cover; background-position: center; background-attachment: fixed;
            background-color: #050505; color: white;
        }

        .card { 
            background: rgba(15, 15, 15, 0.9); backdrop-filter: blur(12px);
            padding: 25px; border-radius: 20px; border: 1px solid rgba(255, 255, 255, 0.15); 
            width: 90%; max-width: 450px; text-align: center; box-shadow: 0 10px 40px rgba(0,0,0,0.8);
        }

        /* LOGO & TITRES */
        .logo-container { margin: 15px auto; width: 120px; height: 120px; perspective: 1000px; cursor: pointer; }
        .wolf-logo {
            width: 100%; height: 100%; border-radius: 50%; box-shadow: 0 0 20px var(--wolf-orange);
            animation: wolf-spin 5s linear infinite; background-image: url('image_0.png'); 
            background-size: cover; background-position: center;
        }
        @keyframes wolf-spin { from { transform: rotateY(0deg); } to { transform: rotateY(360deg); } }

        .multicolor-title {
            font-size: 2em; font-weight: 900; text-transform: uppercase;
            background: linear-gradient(to right, red, orange, yellow, green, blue, indigo, violet);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-size: 400% 400%; animation: gradient-move 5s ease infinite;
        }
        @keyframes gradient-move { 0%{background-position:0% 50%} 50%{background-position:100% 50%} 100%{background-position:0% 50%} }

        /* STRUCTURE */
        .screen { display: none; min-height: 100vh; padding: 20px; flex-direction: column; align-items: center; justify-content: center; box-sizing: border-box; }
        .active { display: flex; animation: fadeIn 0.4s ease; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

        button { width: 100%; padding: 14px; margin-top: 10px; border-radius: 10px; border: none; font-weight: bold; cursor: pointer; color: white; transition: 0.2s; }
        input, textarea, select { width: 100%; padding: 12px; margin: 8px 0; border-radius: 10px; border: 1px solid #444; background: rgba(0,0,0,0.8); color: white; box-sizing: border-box; }
        
        .rule-box { text-align: left; font-size: 0.75em; background: rgba(0,0,0,0.6); padding: 12px; border-radius: 10px; border: 1px solid #333; margin: 10px 0; }
        .grade-badge { padding: 4px 8px; border-radius: 4px; font-size: 0.7em; font-weight: bold; }
    </style>
</head>
<body>

    <section id="scr-welcome" class="screen active">
        <div class="card">
            <h1 class="multicolor-title">BIENVENUE ALPHA</h1>
            <p>Prêt à entrer dans la meute de la <strong>WOLF ACADEMY 76</strong> ?</p>
            <div class="logo-container"><div class="wolf-logo"></div></div>
            <button style="background:var(--wolf-orange);" onclick="showScreen('scr-age')">DÉMARRER L'INSCRIPTION</button>
        </div>
    </section>

    <section id="scr-age" class="screen">
        <div class="card">
            <h2 style="color:var(--wolf-orange);">CRÉATION DE PROFIL</h2>
            <input type="text" id="user-name" placeholder="Nom et Prénom">
            <input type="tel" id="user-phone" placeholder="Numéro de téléphone">
            <input type="date" id="user-birth">
            <div class="rule-box">
                <strong>⚖️ RÈGLES DU CLAN :</strong><br>
                1. Respect pénal | 2. +13 ans | 3. Propriété Intellectuelle | 4. Pas de Spam | 5. Loyauté Clan | 6. Confidentialité | 7. Hiérarchie | 8. Responsabilité.
            </div>
            <button style="background:var(--wolf-orange);" onclick="checkSecurity()">REJOINDRE LA MEUTE</button>
        </div>
    </section>

    <section id="scr-site" class="screen">
        <div class="logo-container" style="width:70px; height:70px;"><div class="wolf-logo" onclick="logoSecretClick()"></div></div>
        <div class="card">
            <h2 class="multicolor-title">HUB ALPHA</h2>
            <div style="text-align:left; margin-bottom:15px; font-size:0.9em;">
                <span id="badge-grade" class="grade-badge">STANDARD</span> | <span id="display-name">Nom</span>
            </div>
            
            <button style="background:var(--wolf-orange);" onclick="showScreen('scr-community')">👥 COMMUNAUTÉ (TCHAT)</button>
            
            <hr style="border:0; border-top:1px solid #333; margin:15px 0;">
            
            <p style="font-size:0.8em; color:var(--wolf-gold);">💎 BOUTIQUE DES ABONNEMENTS :</p>
            <button style="background:var(--wolf-gold); color:black;" onclick="window.location.href='https://la-wolf-academy-76-1.sumupstore.com/'">
                ACCÉDER AU SUMUP STORE ALPHA
            </button>
            
            <button style="background:#222; margin-top:20px; font-size:0.75em;" onclick="window.location.href='mailto:wolffreeze.76ytpro@gmail.com'">📧 SIGNALER DÉPART / REMBOURSEMENT</button>
        </div>
    </section>

    <section id="scr-enquete" class="screen">
        <div class="card" style="border: 2px solid orange;">
            <h1 style="color:orange;">⚖️ ENQUÊTE EN COURS</h1>
            <div id="enquete-content" class="rule-box"></div>
            <textarea id="defense-text" placeholder="Rédigez votre défense ici... (Lettre de plaidoirie)"></textarea>
            <button style="background:orange; color:black;" onclick="envoyerPlaidoirie()">ENVOYER MA DÉFENSE</button>
            <button style="background:#222; margin-top:10px;" onclick="location.reload()">QUITTER</button>
        </div>
    </section>

    <section id="scr-verdict" class="screen">
        <div class="card" style="border: 3px solid red; background: rgba(30,0,0,0.95);">
            <h1 style="color:red;">🚫 VERDICT : REFUSÉ</h1>
            <div id="verdict-details" class="rule-box" style="border-color:red;"></div>
            <div id="verdict-proof" style="background:red; color:white; padding:10px; font-weight:bold; border-radius:5px; margin-top:10px;">
                VIOLATION DE LA RÈGLE N°<span id="regle-num">?</span> SOUS PREUVES.
            </div>
            <p style="font-size:0.65em; margin-top:15px;">Contrat détruit. Accès banni pour 1 an et 30 mois. Aucune rétractation possible.</p>
            <button style="background:#111;" onclick="location.reload()">FERMER</button>
        </div>
    </section>

    <script>
        const CODE_ADMIN = "12 07 2004";
        let logoClicks = 0;

        function checkSecurity() {
            const name = document.getElementById('user-name').value;
            const birth = document.getElementById('user-birth').value;
            const phone = document.getElementById('user-phone').value;
            if(!name || !birth || !phone) return alert("Champs obligatoires !");
            
            localStorage.setItem('user_full_name', name);
            localStorage.setItem('user_phone', phone);
            
            const age = Math.floor((new Date() - new Date(birth)) / 31557600000);
            if(age < 13) {
                localStorage.setItem('block_'+phone, 'true');
                location.reload();
            } else {
                showScreen('scr-site');
                updateUI();
            }
        }

        // --- PORTE DÉROBÉE ---
        function logoSecretClick() {
            logoClicks++;
            if(logoClicks === 5) {
                let code = prompt("CODE ALPHA :");
                if(code === CODE_ADMIN) { alert("Accès Admin ouvert."); /* charger menu admin */ }
                logoClicks = 0;
            }
            setTimeout(() => logoClicks = 0, 3000);
        }

        // --- LOGIQUE DE DÉFENSE ---
        function envoyerPlaidoirie() {
            const msg = document.getElementById('defense-text').value;
            const phone = localStorage.getItem('user_phone');
            const dossier = JSON.parse(localStorage.getItem('enquete_' + phone)).dossier;

            const mail = `mailto:wolffreeze.76ytpro@gmail.com?subject=PLAIDOIRIE_${dossier}&body=${encodeURIComponent(msg)}`;
            window.open(mail, '_blank');
            alert("Lettre de défense transmise à l'administration.");
        }

        function updateUI() {
            const name = localStorage.getItem('user_full_name');
            const phone = localStorage.getItem('user_phone');
            const grade = localStorage.getItem('grade_'+phone) || "STANDARD";
            
            document.getElementById('display-name').innerText = name;
            const badge = document.getElementById('badge-grade');
            badge.innerText = grade;
            badge.style.background = (grade === 'PREMIUM') ? 'var(--wolf-gold)' : (grade === 'PLUS' ? 'var(--wolf-orange)' : '#555');
        }

        function showScreen(id) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(id).classList.add('active');
        }

        window.onload = () => {
            const p = localStorage.getItem('user_phone');
            if(!p) return;

            const enq = localStorage.getItem('enquete_' + p);
            if(enq) {
                const r = JSON.parse(enq);
                if(r.statut === "REFUSÉ") {
                    document.getElementById('verdict-details').innerHTML = `DOSSIER : ${r.dossier}<br>NOM : ${localStorage.getItem('user_full_name')}<br>GRADE : ${r.grade}`;
                    document.getElementById('regle-num').innerText = r.regleCoupable || "?";
                    showScreen('scr-verdict');
                } else {
                    document.getElementById('enquete-content').innerHTML = `DOSSIER : ${r.dossier}<br>MOTIF : ${r.motif}`;
                    showScreen('scr-enquete');
                }
                return;
            }
            showScreen('scr-site');
            updateUI();
        };
    </script>
</body>
</html>
